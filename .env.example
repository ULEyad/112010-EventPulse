# Copy this file to .env and fill in real values. Never commit the real .env file.

PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string (Task 7 - create the cluster on MongoDB Atlas first)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/eventpulse?retryWrites=true&w=majority

# Use a long, random string in real deployments (e.g. `openssl rand -base64 48`)
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
